rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Products catalog (Category removed, SKU sorting supported)
    match /products/{productId} {
      allow read, write: if true;
    }

    // Inbound transactions
    match /inbound_transactions/{id} {
      allow read, write: if true;
    }

    // Outbound transactions
    match /outbound_transactions/{id} {
      allow read, write: if true;
    }

    // Activity logs
    match /activity_logs/{id} {
      allow read, write: if true;
    }

    // Packer sessions
    match /packer_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Packer resi items
    match /packer_resi_items/{itemId} {
      allow read, write: if true;
    }

    // App global state / active batch
    match /system_state/{id} {
      allow read, write: if true;
    }
  }
}
